{
  "rewrites": [
    {
      "source": "/",
      "destination": "/tierly/index.html"
    },
    {
      "source": "/tierly/admin",
      "destination": "/tierly/index.html"
    },
    {
      "source": "/tierly/admin/",
      "destination": "/tierly/index.html"
    },
    {
      "source": "/admin/event",
      "destination": "/tierly/index.html"
    },
    {
      "source": "/admin/event/",
      "destination": "/tierly/index.html"
    },
    {
      "source": "/ops/tierly/",
      "destination": "/ops/tierly/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(supabase|discord-bot|tests|scripts|docs)/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/tierly",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/tierly/",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/ops/tierly",
      "destination": "/ops/tierly/",
      "permanent": true
    }
  ]
}
