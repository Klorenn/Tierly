# Copiar a discord-bot/.env y completar. El bot se arranca con
# `node --env-file=.env index.js` (ver README.md), y systemd lo lee via
# EnvironmentFile, asi que este archivo es la unica fuente de verdad.

# Developer Portal -> Bot -> Reset Token. Si Discord responde 401 al bot,
# este valor esta revocado: regenerarlo aca Y en los secrets de Supabase.
DISCORD_BOT_TOKEN=
# ID del servidor que el bot observa. Tiene que existir como fila en
# public.communities(guild_id) o cada insert viola la FK y falla en silencio.
DISCORD_GUILD_ID=

# Opcionales: si se omiten, el bot busca los canales por nombre
# (bienvenida-tierly / anuncios-tierly).
WELCOME_CHANNEL_ID=
ANNOUNCE_CHANNEL_ID=

# El bot escribe con service_role porque bypasea RLS a proposito.
# NUNCA exponer esta clave en el frontend.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Opcional: antiguedad maxima del ultimo heartbeat antes de que
# healthcheck.mjs considere al bot caido. Default en el script.
TIERLY_HEALTH_MAX_AGE_SECONDS=
