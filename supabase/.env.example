# Secrets de las Edge Functions. No se leen de este archivo en produccion:
# cargarlos con `supabase secrets set --env-file supabase/.env`.
# SUPABASE_URL, SUPABASE_ANON_KEY y SUPABASE_SERVICE_ROLE_KEY ya vienen
# inyectadas por la plataforma; estan listadas solo para correr en local.

# Mismo token que el bot. discord-verify responde
# "El bot de Discord perdio acceso (HTTP 401)" cuando esta revocado.
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
WELCOME_CHANNEL_ID=

# Solo la usa passport-profile.
STELLAR_PASSPORT_API_KEY=

# Local nada mas (`supabase functions serve`).
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
